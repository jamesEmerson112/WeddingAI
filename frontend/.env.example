# copy to .env.local
GEMINI_API_KEY=          # server-side only (app/api/analyze) — must NOT be prefixed NEXT_PUBLIC_
NEXT_PUBLIC_API_URL=     # backend base URL, e.g. https://weddingai-production.up.railway.app; empty = http://localhost:8080
# Scene hosting is the BACKEND's job — it stamps a job's real scene_url into
# artifacts_json (absolute URLs for scenes it serves, or /demo/scene.html for
# the inert stand-in). There is no frontend scene-URL override to configure.
