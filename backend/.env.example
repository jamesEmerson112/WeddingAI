# copy to .env; mock mode needs no credentials, but DOES need a running Postgres
# (`docker compose up -d` from this directory) — unlike the old SQLite setup,
# there is no "create the database if missing".
MOCK_MODE=true                          # true = local demo (no GPU/credentials); false = real RunPod mode
PORT=8080                               # port the backend listens on
PUBLIC_BASE_URL=                        # public URL of this backend (e.g. https://x.up.railway.app); empty = http://localhost:PORT (Railway auto-detects via RAILWAY_PUBLIC_DOMAIN)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/weddingai  # on Railway set this to the reference ${{Postgres.DATABASE_URL}} (private network; DATABASE_PUBLIC_URL bills egress)
TEST_DATABASE_URL=postgres://postgres:postgres@localhost:5432/weddingai_test  # used only by `cargo test`; each test gets its own schema
RUNPOD_API_KEY=                         # RunPod API key (real mode only)
RUNPOD_ENDPOINT_ID=                     # RunPod serverless endpoint id (real mode only)

# --- File storage -----------------------------------------------------------
# The backend brokers ALL file transfer between the browser and the GPU worker,
# storing bytes on an attached disk. There is no object store and neither the
# browser nor the worker holds storage credentials.
#   <DATA_DIR>/uploads/<uuid>.zip   photo zips, browser -> worker
#   <DATA_DIR>/artifacts/...        finished scenes, worker -> browser
DATA_DIR=                               # empty = ./data locally, /data on Railway (the volume mount path)
ADMIN_TOKEN=                            # bearer token for PUT /api/artifacts/*; EMPTY DISABLES that route (404s)
DEMO_SCENE_KEY=                         # e.g. scene-3041.html — filename under artifacts/ that finished MOCK jobs point at; empty = inert placeholder
STORAGE_LIMIT_BYTES=                    # budget the header storage bar fills toward; empty = 5 GiB (the Railway Hobby volume). A soft denominator, not a hard cap.

# NOTE: R2_* are gone. The backend used to plan on Cloudflare R2 (see ROADMAP
# Phase 1); it now serves artifacts itself off the Railway volume, so the worker
# needs PUBLIC_BASE_URL + ADMIN_TOKEN instead of five R2 credentials.
